#!/usr/bin/env bash
# Per-process palette: never edit the user's configuration.
set -euo pipefail

colors=(
  "255:0:255"   # Cyber Pink
  "0:255:255"   # Electric Cyan
  "57:255:20"   # Acid Green
  "191:0:255"   # Ultraviolet
  "255:20:147"  # Hot Pink
  "0:128:255"   # Laser Blue
  "255:95:0"    # Neon Orange
  "204:255:0"   # Electric Lime
  "255:23:68"   # Crimson
  "143:0:255"   # Violet
  "0:255:200"   # Turquoise
  "255:214:0"   # Gold
)
color=${colors[RANDOM % ${#colors[@]}]}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -n ${FFETCH_3D_BIN:-} ]]; then
  binary=$FFETCH_3D_BIN
elif [[ -x "$script_dir/ffetch-3d" ]]; then
  binary=$script_dir/ffetch-3d
elif [[ -x "$script_dir/../ffetch-3d" ]]; then
  binary=$script_dir/../ffetch-3d
else
  binary=ffetch-3d
fi
exec "$binary" -l arch --shading-mode blocks --color "rgb:$color" "$@"
