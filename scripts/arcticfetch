#!/usr/bin/env bash
# Fixed cyan, isolated to this process.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -n ${FFETCH_3D_BIN:-} ]]; then
  binary=$FFETCH_3D_BIN
elif [[ -x "$script_dir/ffetch-3d" ]]; then
  binary=$script_dir/ffetch-3d
elif [[ -x "$script_dir/../ffetch-3d" ]]; then
  binary=$script_dir/../ffetch-3d
else
  binary=ffetch-3d
fi
exec "$binary" -l arch --shading-mode blocks --color rgb:0:255:255 "$@"
